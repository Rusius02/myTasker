<Window x:Class="myTasker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:myTasker.Views"
        Title="Tasker" Height="850" Width="1250">
    <Grid>
        <TabControl>
            <!-- Onglet Gestion des Tâches -->
            <TabItem Header="Gestion des Tâches">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="10">
                        <TextBox x:Name="TaskNameTextBox" Width="150" Text="Nom"/>
                        <TextBox x:Name="TaskDescriptionTextBox" Width="200" Text="Description" Margin="10,0,0,0"/>
                        <DatePicker x:Name="TaskDueDatePicker" Width="150" Margin="10,0,0,0"/>
                        <Button Content="Ajouter Tâche" Click="AddTaskButton_Click" Margin="10,0,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="TaskDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="200"/>
                            <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Date Limite" Binding="{Binding DueDate}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Onglet Gestion des Projets -->
            <TabItem Header="Gestion des Projets">
                <Grid x:Name="ProjectContainer">
                    <!-- Le contrôle ProjectManagement sera ajouté dynamiquement ici -->
                </Grid>
            </TabItem>

            <!-- Onglet Gestion des Membres -->
            <TabItem Header="Gestion des Membres">
                <Grid x:Name="MemberContainer">
                    <!-- Le contrôle ProjectManagement sera ajouté dynamiquement ici -->
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
